prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// 1. ORGANIZATION & LOCATION (MULTI-TENANT BASE)
// -----------------------------------------------------------------------------

model Tenant {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String   @db.VarChar(255)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  deletedAt        DateTime? 
  branches         Branch[]
  products         Product[]
  inventoryBatches InventoryBatch[]
  transactions     Transaction[]
  @@map("tenants")
}

model Branch {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @db.Uuid
  name             String   @db.VarChar(255)
  address          String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  deletedAt        DateTime?
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inventoryBatches InventoryBatch[]
  transactions     Transaction[]
  @@map("branches")
}

// -----------------------------------------------------------------------------
// 2. MASTER DATA (PRODUCTS)
// -----------------------------------------------------------------------------

model Product {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @db.Uuid
  sku              String   @db.VarChar(100)
  name             String   @db.VarChar(255)
  barcode          String?  @db.VarChar(255)
  defaultPrice     Decimal  @db.Decimal(12, 2) 
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  deletedAt        DateTime?
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inventoryBatches InventoryBatch[]
  transactionItems TransactionItem[]
  @@unique([tenantId, sku])
  @@map("products")
}

// -----------------------------------------------------------------------------
// 3. INVENTORY (FEFO BATCH ENGINE)
// -----------------------------------------------------------------------------

model InventoryBatch {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @db.Uuid
  branchId         String   @db.Uuid
  productId        String   @db.Uuid
  batchNumber      String?  @db.VarChar(100) 
  receivedDate     DateTime 
  expiryDate       DateTime? 
  unitCost         Decimal  @db.Decimal(12, 2) // COGS snapshot upon receipt
  initialQty       Int      
  currentQty       Int      // Can go negative due to offline sync tolerance
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  deletedAt        DateTime?
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch           Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  product          Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  transactionItemBatches TransactionItemBatch[]
  
  // Crucial index for fast FEFO querying
  @@index([tenantId, branchId, productId, expiryDate(sort: Asc), receivedDate(sort: Asc)])
  @@map("inventory_batches")
}

// -----------------------------------------------------------------------------
// 4. TRANSACTIONS (POS OUTBOUND)
// -----------------------------------------------------------------------------

model Transaction {
  // ID generated by Frontend (WatermelonDB UUID) for safe offline syncing
  id               String   @id @db.Uuid 
  tenantId         String   @db.Uuid
  branchId         String   @db.Uuid
  receiptNumber    String   @db.VarChar(100)
  totalAmount      Decimal  @db.Decimal(12, 2)
  paymentMethod    String   @db.VarChar(50) 
  cashierPinUsed   String?  @db.VarChar(10) 
  transactionDate  DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch           Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  items            TransactionItem[]
  @@map("transactions")
}

model TransactionItem {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionId    String  @db.Uuid
  productId        String  @db.Uuid
  quantity         Int
  sellingPrice     Decimal @db.Decimal(12, 2) 
  discountAmount   Decimal @default(0) @db.Decimal(12, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  transaction      Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  product          Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  batchesApplied   TransactionItemBatch[]
  @@map("transaction_items")
}

// Ledger table to map exactly which FEFO batches were deducted (Accurate COGS)
model TransactionItemBatch {
  id                  String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionItemId   String @db.Uuid
  inventoryBatchId    String @db.Uuid
  qtyDeducted         Int
  costApplied         Decimal @db.Decimal(12, 2) // Snapshot of unitCost from the deducted batch
  createdAt           DateTime @default(now())
  transactionItem     TransactionItem @relation(fields: [transactionItemId], references: [id], onDelete: Cascade)
  inventoryBatch      InventoryBatch  @relation(fields: [inventoryBatchId], references: [id], onDelete: Restrict)
  @@map("transaction_item_batches")
}