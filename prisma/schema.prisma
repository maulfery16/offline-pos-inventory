generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// 1. ORGANIZATION & LOCATION (MULTI-TENANT BASE)
// -----------------------------------------------------------------------------

model Tenant {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String   @db.VarChar(255)
  code             String   @unique @db.VarChar(50)
  address          String?  @db.Text
  phone            String?  @db.VarChar(50)
  email            String?  @db.VarChar(255)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  deletedAt        DateTime?
  branches         Branch[]
  users            User[]
  devices          Device[]
  products         Product[]
  inventoryBatches InventoryBatch[]
  transactions     Transaction[]
  shiftReports     ShiftReport[]
  @@map("tenants")
}

model Branch {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @db.Uuid
  name             String   @db.VarChar(255)
  code             String   @db.VarChar(50)
  address          String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  deletedAt        DateTime?
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inventoryBatches InventoryBatch[]
  transactions     Transaction[]
  devices          Device[]
  shiftReports     ShiftReport[]
  @@unique([tenantId, code])
  @@map("branches")
}

// -----------------------------------------------------------------------------
// 2. AUTH (USERS & DEVICES)
// -----------------------------------------------------------------------------

model User {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid
  name      String   @db.VarChar(255)
  pinHash   String   @db.VarChar(255)
  role      String   @db.VarChar(50)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@map("users")
}

model TenantAdmin {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @unique @db.Uuid
  passwordHash String   @db.VarChar(255)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@map("tenant_admins")
}

model Device {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @db.Uuid
  branchId   String    @db.Uuid
  name       String    @db.VarChar(255)
  isRevoked  Boolean   @default(false)
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch     Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  @@map("devices")
}

// -----------------------------------------------------------------------------
// 3. MASTER DATA (PRODUCTS)
// -----------------------------------------------------------------------------

model Product {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @db.Uuid
  sku              String   @db.VarChar(100)
  name             String   @db.VarChar(255)
  barcode          String?  @db.VarChar(255)
  unit             String   @default("pcs") @db.VarChar(50)
  reorderPoint     Int      @default(0)
  defaultPrice     Decimal  @db.Decimal(12, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  deletedAt        DateTime?
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inventoryBatches InventoryBatch[]
  transactionItems TransactionItem[]
  @@unique([tenantId, sku])
  @@map("products")
}

// -----------------------------------------------------------------------------
// 4. INVENTORY (FEFO BATCH ENGINE)
// -----------------------------------------------------------------------------

model InventoryBatch {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String    @db.Uuid
  branchId         String    @db.Uuid
  productId        String    @db.Uuid
  batchNumber      String?   @db.VarChar(100)
  receivedDate     DateTime
  expiryDate       DateTime?
  unitCost         Decimal   @db.Decimal(12, 2)
  initialQty       Int
  currentQty       Int
  isBlocked        Boolean   @default(false)
  hasAnomalyFlag   Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch           Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  product          Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  transactionItemBatches TransactionItemBatch[]
  @@index([tenantId, branchId, productId, expiryDate(sort: Asc), receivedDate(sort: Asc)])
  @@map("inventory_batches")
}

// -----------------------------------------------------------------------------
// 5. TRANSACTIONS (POS OUTBOUND)
// -----------------------------------------------------------------------------

model Transaction {
  id               String   @id @db.Uuid
  tenantId         String   @db.Uuid
  branchId         String   @db.Uuid
  receiptNumber    String   @db.VarChar(100)
  totalAmount      Decimal  @db.Decimal(12, 2)
  paymentMethod    String   @db.VarChar(50)
  cashierPinUsed   String?  @db.VarChar(10)
  transactionDate  DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch           Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  items            TransactionItem[]
  @@map("transactions")
}

model TransactionItem {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionId    String  @db.Uuid
  productId        String  @db.Uuid
  quantity         Int
  sellingPrice     Decimal @db.Decimal(12, 2)
  discountAmount   Decimal @default(0) @db.Decimal(12, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  transaction      Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  product          Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  batchesApplied   TransactionItemBatch[]
  @@map("transaction_items")
}

model TransactionItemBatch {
  id                  String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionItemId   String  @db.Uuid
  inventoryBatchId    String  @db.Uuid
  qtyDeducted         Int
  costApplied         Decimal @db.Decimal(12, 2)
  createdAt           DateTime @default(now())
  transactionItem     TransactionItem @relation(fields: [transactionItemId], references: [id], onDelete: Cascade)
  inventoryBatch      InventoryBatch  @relation(fields: [inventoryBatchId], references: [id], onDelete: Restrict)
  @@map("transaction_item_batches")
}

// -----------------------------------------------------------------------------
// 6. SHIFT REPORTS
// -----------------------------------------------------------------------------

model ShiftReport {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @db.Uuid
  branchId         String   @db.Uuid
  closedAt         DateTime @default(now())
  expectedCash     Decimal  @db.Decimal(12, 2)
  physicalCash     Decimal  @db.Decimal(12, 2)
  variance         Decimal  @db.Decimal(12, 2)
  status           String   @db.VarChar(20)  // 'ok' or 'review'
  note             String?  @db.Text
  closedByDeviceId String   @db.Uuid
  transactionCount Int      @default(0)
  totalRevenue     Decimal  @db.Decimal(12, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch           Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  @@map("shift_reports")
}
